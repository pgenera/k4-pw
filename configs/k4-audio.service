# Systemd user service for the Elecraft K4 PipeWire Audio + CAT Bridge.
# Activated on-demand by k4-audio.socket when WSJT-X connects to 127.0.0.1:9200
# (or started manually via `systemctl --user start k4-audio.service`).
# Exits cleanly with status 0 after K4_IDLE_TIMEOUT (default 20s when socket-activated)
# once WSJT-X closes its CAT connection, handing 127.0.0.1:9200 back to systemd.

[Unit]
Description=Elecraft K4 PipeWire Audio Bridge
After=pipewire.service pipewire-pulse.service
Wants=pipewire.service pipewire-pulse.service
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=-%h/.config/k4-audio/config.env
# Adjust ExecStart if cloned elsewhere:
ExecStart=%h/k4-pw/bin/k4-audio
Restart=on-failure
RestartSec=3
