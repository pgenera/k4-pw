# Copy to ~/.config/k4-audio/config.env
# Lines starting with # are ignored. CLI flags override values set here.

# Elecraft K4 IP address or hostname (required unless passed via --host)
K4_HOST=192.168.1.100

# Elecraft K4 remote audio/CAT port (default: 9205)
K4_PORT=9205

# Local TCP CAT listener for WSJT-X (multiplexes all CAT + PTT over the :9205
# session using a single K4 client slot so K4 routes :9205 TX audio to DAP)
K4_CAT_LISTEN=127.0.0.1:9200

# Optional K4 network password (leave commented if password auth is disabled)
# K4_PASSWORD=
# Or load the password from a file (0600 permissions recommended):
# K4_PASSWORD_FILE=~/.config/k4-audio/password

# Audio gain trims in dB (0 = unity)
K4_RX_GAIN_DB=0
K4_TX_GAIN_DB=0

# RX jitter buffer prefill target in milliseconds
K4_BUFFER_MS=40

# TX voice/audio activity gate threshold (raw S16 peak in 0..32767) and hold tail
K4_SILENCE_THRESHOLD=2
K4_TX_HOLD_MS=100

# Set true only if you want k4-audio to send TX;/RX; CAT commands on :9205 audio activity
# (Leave false when WSJT-X handles PTT via CAT; set true if using WSJT-X PTT=VOX)
K4_TX_CAT_ON_AUDIO=false

# Audio backend: auto, pulse, pw-cat, or mock
K4_BACKEND=auto

# PipeWire virtual node names (descriptions: "Elecraft K4 RX" / "Elecraft K4 TX")
K4_RX_NODE=k4_rx
K4_TX_NODE=k4_tx

# Set true if managing PipeWire nodes externally
K4_NO_EPHEMERAL_NODES=false

# Set true to disable automatic reconnect with backoff
K4_ONCE=false

# Set true to periodically log RX/TX audio levels and buffer stats
K4_LOG_LEVELS=false
